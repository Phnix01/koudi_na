# Copier en ios/fastlane/.env (ignoré par git) et remplir.
# Clé créée dans App Store Connect > Utilisateurs et accès > Intégrations >
# API App Store Connect, rôle « App Manager ». Le fichier .p8 ne se télécharge
# qu'une fois : le ranger dans ~/.appstoreconnect/private_keys/.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optionnel, si le .p8 n'est pas dans ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
# ASC_KEY_PATH=
